CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=20
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_IRAM_OPT=y
# BLE controller for the P4's NimBLE; both switches are needed or the feature is not built at all
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_CACHE_MALLOC=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The P4 and this firmware talk through it (components/c6/include/c6_protocol.h)
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y
# Network Split: this chip runs DHCP and answers ARP and ping for the P4's address; the P4 takes its ports (49152-61439) and
# TCP 22. 22 is no source port, or the answers to this chip's own SSH checks would go to the P4
CONFIG_ESP_HOSTED_CP_FEAT_NW_SPLIT=y
CONFIG_ESP_HOSTED_DEFAULT_NETWORK_STACK_DHCP_COPROCESSOR=y
CONFIG_ESP_HOSTED_HOST_TCP_DST_PORTS="22"
# join_known picks the network
CONFIG_ESP_HOSTED_CP_FEAT_NW_SPLIT_WIFI_AUTO_CONNECT_ON_STA_START=n
# Until a P4 sends its own (P4_HOSTNAME)
CONFIG_LWIP_LOCAL_HOSTNAME="tab5"
