{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The SD card's .config/tab5-ssh/config.json; without it the Tab5 runs on the defaults. Where to connect comes from the SD card's .ssh/config.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "bars": {
      "additionalProperties": false,
      "description": "Above and below the terminal; not both off",
      "properties": {
        "battery": {
          "default": "volts",
          "description": "The battery in the top bar",
          "enum": [
            "volts",
            "percent"
          ]
        },
        "bottom": {
          "default": true,
          "type": "boolean"
        },
        "top": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "echo": {
      "additionalProperties": false,
      "description": "Keys shown before the host echoes them",
      "properties": {
        "delay_ms": {
          "default": 50,
          "description": "Once this long without the echo",
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "log": {
      "additionalProperties": false,
      "description": "Logs on the SD card in .local/state/tab5-ssh/log/, YYYY-MM-DD-NN.log",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "file_kb": {
          "default": 1024,
          "description": "A new file past this size",
          "maximum": 65536,
          "minimum": 16,
          "type": "integer"
        },
        "keep_days": {
          "default": 14,
          "description": "Dated files older than this are deleted",
          "maximum": 3650,
          "minimum": 1,
          "type": "integer"
        },
        "keep_mb": {
          "default": 32,
          "description": "The oldest files are deleted past this total",
          "maximum": 65536,
          "minimum": 1,
          "type": "integer"
        },
        "session_level": {
          "default": "info",
          "description": "warn: only warnings and the control commands' replies while a session runs",
          "enum": [
            "info",
            "warn"
          ]
        }
      },
      "type": "object"
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "lte": {
          "additionalProperties": false,
          "description": "Through a Stamp CAT-M",
          "properties": {
            "enabled": {
              "default": true,
              "description": "On from boot; lte on|off save",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "wifi": {
          "additionalProperties": false,
          "properties": {
            "access_points": {
              "description": "Tried in this order; only networks a scan sees",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "password": {
                    "description": "Absent for an open network",
                    "maxLength": 64,
                    "type": "string"
                  },
                  "ssid": {
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "ssid"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "enabled": {
              "default": true,
              "description": "On from boot; wifi on|off save",
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "remote": {
      "additionalProperties": false,
      "description": "The control commands over SSH on port 22, for the keys in the SD card's .ssh/authorized_keys",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "lte": {
          "default": false,
          "description": "Also from the LTE address, not only Wi-Fi",
          "type": "boolean"
        },
        "user": {
          "default": "",
          "description": "Only this SSH user name; empty: any, the key alone decides",
          "maxLength": 32,
          "type": "string"
        }
      },
      "type": "object"
    },
    "sleep": {
      "additionalProperties": false,
      "description": "The screen off without a key or a touch, then light sleep while no computer uses USB-C",
      "properties": {
        "idle_minutes": {
          "default": 0,
          "description": "0: never",
          "maximum": 60,
          "minimum": 0,
          "type": "integer"
        },
        "usb_a": {
          "default": false,
          "description": "The USB-A port's 5 V kept on while asleep; a USB keyboard cannot wake the Tab5 anyway",
          "type": "boolean"
        },
        "wifi_wake": {
          "default": false,
          "description": "Experimental: the C6's traffic wakes it too",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "timezone": {
      "default": "KST-9",
      "description": "POSIX TZ, for log dates and times",
      "maxLength": 47,
      "minLength": 1,
      "type": "string"
    },
    "touch": {
      "additionalProperties": false,
      "description": "Touch on the terminal",
      "properties": {
        "arrows": {
          "default": true,
          "description": "A drag on the alternate screen of a program without mouse reports sends Up/Down keys",
          "type": "boolean"
        },
        "wheel_px": {
          "default": 48,
          "description": "Pixels of drag per wheel report or scrollback line",
          "maximum": 240,
          "minimum": 12,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "title": "Tab5 SSH client configuration",
  "type": "object"
}
