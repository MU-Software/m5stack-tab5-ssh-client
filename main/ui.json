{
  "screens": {
    "main": {
      "rows": [
        {
          "height": 1,
          "when": "bars.top",
          "style": "bar",
          "columns": [
            {"text": " {host}"},
            {"width": 22, "align": "right", "style": "alert", "text": "{status}"},
            {"width": 30, "align": "right", "text": "{network}"},
            {"width": 7, "align": "right", "text": "{battery}"},
            {"width": 7, "align": "right", "text": "{time} "}
          ]
        },
        {"terminal": {}},
        {
          "height": 1,
          "when": "bars.bottom",
          "style": "bar",
          "columns": [
            {"button": "hosts", "text": "호스트"},
            {"button": "network", "text": "망"},
            {"button": "settings", "text": "설정"}
          ]
        }
      ]
    },
    "hosts": {
      "style": "panel",
      "rows": [
        {
          "height": 1,
          "columns": [
            {"style": "title", "text": " 호스트"},
            {"width": 10, "style": "button", "button": "close", "text": "닫기"}
          ]
        },
        {"height": 1, "style": "hint", "text": " ↑↓ 고르기 · Enter 접속 · Esc 닫기"},
        {"height": 1, "style": "alert", "text": " {countdown}"},
        {"list": "hosts", "item": "  {alias:16}{user}@{hostname}:{port:7}{current}", "action": "connect"}
      ]
    },
    "network": {
      "style": "panel",
      "rows": [
        {
          "height": 1,
          "columns": [
            {"style": "title", "text": " 망"},
            {"width": 10, "style": "button", "button": "close", "text": "닫기"}
          ]
        },
        {"height": 1, "style": "hint", "text": " Tab 이동 · Enter 누르기 · Esc 닫기"},
        {"height": 1, "text": ""},
        {"height": 1, "columns": [{"width": 12, "style": "label", "text": " 경로"}, {"text": "{path}"}]},
        {"height": 1, "text": ""},
        {
          "height": 1,
          "columns": [
            {"width": 12, "style": "label", "text": " Wi-Fi"},
            {"text": "{wifi.state}"},
            {"width": 10, "style": "button", "button": "wifi on", "text": "켜기"},
            {"width": 1, "text": ""},
            {"width": 10, "style": "button", "button": "wifi off save", "text": "끄기"},
            {"width": 2, "text": ""}
          ]
        },
        {"height": 1, "columns": [{"width": 12, "text": ""}, {"style": "hint", "text": "{wifi.detail}"}]},
        {"height": 1, "text": ""},
        {
          "height": 1,
          "columns": [
            {"width": 12, "style": "label", "text": " LTE"},
            {"text": "{lte.state}"},
            {"width": 10, "style": "button", "button": "lte on", "text": "켜기"},
            {"width": 1, "text": ""},
            {"width": 10, "style": "button", "button": "lte off save", "text": "끄기"},
            {"width": 2, "text": ""}
          ]
        },
        {"height": 1, "columns": [{"width": 12, "text": ""}, {"style": "hint", "text": "{lte.detail}"}]},
        {"height": 1, "style": "hint", "text": " 켜고 끈 것은 재시작 뒤에도 그대로"},
        {"height": 1, "text": ""},
        {"height": 1, "style": "section", "text": " 저장된 Wi-Fi"},
        {"list": "wifi", "item": "   {ssid}"}
      ]
    },
    "modem": {
      "style": "panel",
      "rows": [
        {
          "height": 1,
          "columns": [
            {"style": "title", "text": " 모뎀 (Stamp CAT-M)"},
            {"width": 12, "style": "button", "button": "modem read", "text": "다시 읽기"},
            {"width": 1, "text": ""},
            {"width": 10, "style": "button", "button": "settings", "text": "설정"},
            {"width": 1, "text": ""},
            {"width": 10, "style": "button", "button": "close", "text": "닫기"}
          ]
        },
        {"height": 1, "style": "hint", "text": " Tab 이동 · Enter 누르기 · Esc 닫기 · 다이얼마다 읽음, 설정 값은 부팅 때"},
        {"height": 1, "style": "alert", "text": " {modem.read}"},
        {"height": 1, "style": "section", "text": " 망"},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   등록"}, {"text": "{modem.registration}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.registration.age} "}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   사업자"}, {"text": "{modem.operator}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.operator.age} "}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   셀"}, {"text": "{modem.cell}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.cell.age} "}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   신호"}, {"text": "{modem.signal}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.signal.age} "}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   PDP"}, {"text": "{modem.bearer}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.bearer.age} "}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   SIM"}, {"text": "{modem.sim}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.sim.age} "}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   back-off"}, {"text": "{modem.backoff}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.backoff.age} "}]},
        {"height": 1, "text": ""},
        {"height": 1, "style": "section", "text": " 펌웨어가 지키는 값 · 부팅 때 back-off가 보이지 않으면 맞춤"},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   QUALCOMM 알림"}, {"text": "{modem.qualcomm_urc}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.qualcomm_urc.age} "}]},
        {"height": 1, "columns": [{"width": 18, "text": ""}, {"style": "hint", "text": "QCSRVCINFO·$QCJDSTATE 줄, 꺼져 있으면 켬 (CURCCFG)"}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   저전압 꺼짐"}, {"text": "{modem.battery_check}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.battery_check.age} "}]},
        {"height": 1, "columns": [{"width": 18, "text": ""}, {"style": "hint", "text": "VBAT 2.5 V 아래에서 모뎀이 스스로 꺼짐, 꺼져 있으면 켬 (CBATCHK)"}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   eDRX"}, {"text": "{modem.edrx}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.edrx.age} "}]},
        {"height": 1, "columns": [{"width": 18, "text": ""}, {"style": "hint", "text": "망이 허용하고 있으면 끔 (CEDRXS=0,4)"}]},
        {"height": 1, "text": ""},
        {"height": 1, "style": "section", "text": " 모뎀"},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   펌웨어"}, {"text": "{modem.revision}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.revision.age} "}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   망 방식"}, {"text": "{modem.mode}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.mode.age} "}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   CAT-M 밴드"}, {"text": "{modem.bands}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.bands.age} "}]},
        {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   PSM"}, {"text": "{modem.psm}"}, {"width": 9, "style": "hint", "align": "right", "text": "{modem.psm.age} "}]}
      ]
    },
    "restart": {
      "style": "panel",
      "rows": [
        {"height": "40%", "text": ""},
        {"height": 1, "align": "center", "style": "title", "text": "Tab5를 다시 시작할까요?"},
        {"height": 1, "align": "center", "style": "hint", "text": "SSH 세션은 끊기고, tmux 세션은 호스트에 남습니다"},
        {"height": 1, "text": ""},
        {
          "height": 1,
          "columns": [
            {"text": ""},
            {"width": 14, "style": "button", "button": "settings", "text": "취소"},
            {"width": 2, "text": ""},
            {"width": 14, "style": "button", "button": "reboot", "text": "재시작"},
            {"text": ""}
          ]
        }
      ]
    },
    "settings": {
      "style": "panel",
      "rows": [
        {
          "height": 1,
          "columns": [
            {"style": "title", "text": " 설정"},
            {"width": 10, "style": "button", "button": "modem", "text": "모뎀"},
            {"width": 1, "text": ""},
            {"width": 10, "style": "button", "button": "restart", "text": "재시작"},
            {"width": 1, "text": ""},
            {"width": 10, "style": "button", "button": "close", "text": "닫기"}
          ]
        },
        {"height": 1, "style": "hint", "text": " Tab·↑↓ 이동 · ←→ 바꾸기 · Enter 바꾸기·입력 · Esc 닫기"},
        {"height": 1, "text": ""},
        {
          "columns": [
            {
              "rows": [
                {"height": 1, "style": "section", "text": " 화면·입력"},
                {"height": 1, "text": ""},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   예측 에코"}, {"width": 16, "toggle": "echo.enabled"}]},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   에코 지연"}, {"width": 16, "number": "echo.delay_ms"}]},
                {"height": 1, "text": ""},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   위 바"}, {"width": 16, "toggle": "bars.top"}]},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   아래 바"}, {"width": 16, "toggle": "bars.bottom"}]},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   배터리 표시"}, {"width": 16, "choice": "bars.battery"}]}
              ]
            },
            {
              "rows": [
                {"height": 1, "style": "section", "text": " 로그·시간"},
                {"height": 1, "text": ""},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   SD 로그"}, {"width": 16, "toggle": "log.enabled"}]},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   세션 중 수준"}, {"width": 16, "choice": "log.session_level"}]},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   파일 크기"}, {"width": 16, "number": "log.file_kb"}]},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   보관 용량"}, {"width": 16, "number": "log.keep_mb"}]},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   보관 일수"}, {"width": 16, "number": "log.keep_days"}]},
                {"height": 1, "text": ""},
                {"height": 1, "columns": [{"width": 18, "style": "label", "text": "   시간대"}, {"width": 24, "field": "timezone"}]}
              ]
            }
          ]
        }
      ]
    }
  },
  "styles": {
    "bar": {"background": "#2a2a2e", "foreground": "#d8d8d8"},
    "alert": {"foreground": "#ffcc00", "bold": true},
    "panel": {"background": "#14161a", "foreground": "#e0e0e0"},
    "title": {"foreground": "#ffffff", "bold": true},
    "section": {"foreground": "#7fb4ff", "bold": true},
    "label": {"foreground": "#a8a8a8"},
    "hint": {"foreground": "#707478"},
    "button": {"background": "#3a3d44", "foreground": "#ffffff"}
  }
}
