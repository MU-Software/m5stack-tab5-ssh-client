+test "row moves: an update that fails anywhere is retried in full" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var fail_index: usize = 0;
+    while (true) : (fail_index += 1) {
+        var t = try Terminal.init(io, alloc, .{ .cols = 10, .rows = 5, .max_scrollback_bytes = 0 });
+        defer t.deinit(alloc);
+        var s = t.vtStream();
+        defer s.deinit();
+        s.nextSlice("\x1b[?1049h1\r\n2\r\n3\r\n4\r\n5");
+
+        var state: RenderState = .empty;
+        defer state.deinit(alloc);
+        state.track_row_moves = true;
+        try state.update(alloc, &t);
+        state.clean();
+        try state.update(alloc, &t);
+        state.clean();
+
+        // Rows that only moved are left clean, and the new row needs a
+        // grapheme copy.
+        s.nextSlice("\ne\xcc\x81");
+        var failing = testing.FailingAllocator.init(alloc, .{ .fail_index = fail_index });
+        state.update(failing.allocator(), &t) catch {
+            state.clean();
+            try state.update(alloc, &t);
+            var fresh: RenderState = .empty;
+            defer fresh.deinit(alloc);
+            try fresh.update(alloc, &t);
+            try testCompareStates(&state, &fresh);
+            continue;
+        };
+        break;
+    }
+    try testing.expect(fail_index > 1);
+}
