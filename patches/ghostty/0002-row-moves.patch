+/// A renderer's view of a row: its cells with styles resolved.
+fn testRowHash(state: *const RenderState, y: usize) u64 {
+    var h = std.hash.Wyhash.init(0);
+    const cells = state.row_data.items(.cells)[y].slice();
+    for (cells.items(.raw), cells.items(.style), cells.items(.grapheme)) |raw, st, gr| {
+        var r = raw;
+        r.style_id = 0;
+        h.update(std.mem.asBytes(&@as(page.Cell.Backing, @bitCast(r))));
+        if (raw.style_id != 0) h.update(std.mem.asBytes(&st.hash()));
+        if (raw.content_tag == .codepoint_grapheme) h.update(std.mem.sliceAsBytes(gr));
+    }
+    return h.final();
+}
