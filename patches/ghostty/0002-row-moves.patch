+test "row moves leave moved rows clean" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var t = try Terminal.init(io, alloc, .{ .cols = 10, .rows = 5, .max_scrollback_bytes = 0 });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    s.nextSlice("\x1b[?1049h1\r\n2\r\n3\r\n4\r\n5");
+
+    var state: RenderState = .empty;
+    defer state.deinit(alloc);
+    state.track_row_moves = true;
+    try state.update(alloc, &t);
+    state.clean();
+    try state.update(alloc, &t);
+    state.clean();
+
+    // LF at the bottom of the alternate screen: one row moves up.
+    s.nextSlice("\n");
+    try state.update(alloc, &t);
+    try testing.expectEqual(.partial, state.dirty);
+    try testing.expectEqual(@as(u8, 1), state.row_moves.len);
+    try testing.expectEqual(Screen.RowMoves.Move{ .top = 0, .bottom = 5, .n = 1 }, state.row_moves.items[0]);
+    const dirties = state.row_data.items(.dirty);
+    for (0..4) |y| try testing.expect(!dirties[y]);
+    try testing.expect(dirties[4]);
+    try testing.expectEqual('2', state.row_data.items(.cells)[0].get(0).raw.codepoint());
+    state.clean();
+
+    // Reverse index at the top: one row moves down.
+    s.nextSlice("\x1b[H\x1bM");
+    try state.update(alloc, &t);
+    try testing.expectEqual(Screen.RowMoves.Move{ .top = 0, .bottom = 5, .n = -1 }, state.row_moves.items[0]);
+    // Row 1 is old row 0, dirty from the cursor move; the rest only moved.
+    try testing.expect(state.row_data.items(.dirty)[0]);
+    for (2..5) |y| try testing.expect(!state.row_data.items(.dirty)[y]);
+    try testing.expectEqual('2', state.row_data.items(.cells)[1].get(0).raw.codepoint());
+}
