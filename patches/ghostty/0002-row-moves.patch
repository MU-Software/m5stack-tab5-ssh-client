+/// A renderer that keeps its own rows, replays the row moves and rebuilds
+/// only dirty rows must match a fresh render state after every update.
+fn testRowMovesReplay(track: bool) !void {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var prng = std.Random.DefaultPrng.init(0x5C20_11ED);
+    const rand = prng.random();
+
+    var t = try Terminal.init(io, alloc, .{
+        .cols = 20,
+        .rows = 8,
+        .max_scrollback_bytes = 500,
+    });
+    defer t.deinit(alloc);
+
+    var s = t.vtStream();
+    defer s.deinit();
+
+    var inc: RenderState = .empty;
+    defer inc.deinit(alloc);
+    inc.track_row_moves = track;
+
+    var model: [8]u64 = @splat(0);
+    var replayed: usize = 0;
+    var buf: [64]u8 = undefined;
+    for (0..600) |_| {
+        for (0..rand.intRangeAtMost(usize, 1, 6)) |_| {
+            switch (rand.intRangeAtMost(u8, 0, 15)) {
+                0, 1 => for (0..rand.intRangeAtMost(usize, 1, 30)) |_| {
+                    s.nextSlice(&.{rand.intRangeAtMost(u8, 'A', 'Z')});
+                },
+                2, 3 => for (0..rand.intRangeAtMost(usize, 1, 10)) |_| s.nextSlice("x\r\n"),
+                4 => s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[{};{}H", .{
+                    rand.intRangeAtMost(u16, 1, 8),
+                    rand.intRangeAtMost(u16, 1, 20),
+                })),
+                5 => s.nextSlice(switch (rand.intRangeAtMost(u8, 0, 2)) {
+                    0 => "\x1b[48;2;30;60;90m",
+                    1 => "\x1b[38;5;120m",
+                    else => "\x1b[0m",
+                }),
+                6 => s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[{}L", .{rand.intRangeAtMost(u16, 1, 4)})),
+                7 => s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[{}M", .{rand.intRangeAtMost(u16, 1, 4)})),
+                8 => s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[{}S", .{rand.intRangeAtMost(u16, 1, 4)})),
+                9 => s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[{}T", .{rand.intRangeAtMost(u16, 1, 4)})),
+                10 => {
+                    const top = rand.intRangeAtMost(u16, 1, 4);
+                    const bot = rand.intRangeAtMost(u16, top + 1, 8);
+                    s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[{};{}r", .{ top, bot }));
+                },
+                11 => s.nextSlice(if (rand.boolean()) "\x1bM" else "\x1b[r"),
+                12 => s.nextSlice("字👨‍👩‍👧"),
+                13 => s.nextSlice(if (rand.boolean()) "\x1b[?1049h" else "\x1b[?1049l"),
+                14 => {
+                    const l = rand.intRangeAtMost(u16, 1, 10);
+                    const r = rand.intRangeAtMost(u16, l + 1, 20);
+                    s.nextSlice(try std.fmt.bufPrint(&buf, "\x1b[?69h\x1b[{};{}s", .{ l, r }));
