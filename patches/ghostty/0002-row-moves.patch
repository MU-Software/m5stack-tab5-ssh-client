+/// Full-width row moves of the active area since the last render state
+/// update. See RowMoves.
+row_moves: RowMoves = .{},
+
+/// A short log of full-width row moves of the active area, recorded by the
+/// scroll primitives and consumed by RenderState.beginUpdate. A consumer that
+/// applies the moves in order to its copy of the previous rows and then
+/// rebuilds the dirty rows gets the current rows. Partial-width (left/right
+/// margin) moves are not recorded: they keep their rows dirty.
+pub const RowMoves = struct {
+    pub const capacity = 16;
+
+    /// Rows [top, bottom) of the active area: the row at y + n moves to y.
+    /// n > 0 moves content up, n < 0 down. |n| is at most bottom - top.
+    pub const Move = struct {
+        top: size.CellCountInt,
+        bottom: size.CellCountInt,
+        n: i32,
+    };
+
+    items: [capacity]Move = undefined,
+    len: u8 = 0,
+
+    /// Moves were lost: the log no longer describes the changes.
+    overflow: bool = false,
+
+    /// Set by the consumer: scroll fast paths leave rows that only moved
+    /// clean, because the consumer replays the moves.
+    clean_moves: bool = false,
+
+    /// Some fast path left moved rows clean since the last reset.
+    cleaned: bool = false,
+
+    pub fn record(self: *RowMoves, top: usize, bottom: usize, n: isize) void {
+        if (self.overflow) return;
+        const h: i32 = @intCast(bottom - top);
+        const d: i32 = std.math.clamp(@as(i32, @intCast(n)), -h, h);
+        if (self.len > 0) {
+            const last = &self.items[self.len - 1];
+            if (last.top == top and last.bottom == bottom and (last.n > 0) == (d > 0)) {
+                last.n = std.math.clamp(last.n + d, -h, h);
+                return;
+            }
+        }
+        if (self.len == capacity) {
+            self.overflow = true;
+            return;
+        }
+        self.items[self.len] = .{ .top = @intCast(top), .bottom = @intCast(bottom), .n = d };
+        self.len += 1;
+    }
+
+    /// Whether a fast path may leave its moved rows clean (and must say so).
+    pub fn leaveClean(self: *RowMoves) bool {
+        if (!self.clean_moves or self.overflow) return false;
+        self.cleaned = true;
+        return true;
+    }
+
+    pub fn slice(self: *const RowMoves) []const Move {
+        return self.items[0..self.len];
+    }
+
+    pub fn reset(self: *RowMoves) void {
+        self.len = 0;
+        self.overflow = false;
+        self.cleaned = false;
+    }
+};
