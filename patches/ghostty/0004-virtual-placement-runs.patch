+/// C: GhosttyKittyGraphicsVirtualRun
+pub const VirtualRun = extern struct {
+    size: usize = @sizeOf(VirtualRun),
+    image_id: u32 = 0,
+    placement_id: u32 = 0,
+    viewport_col: u32 = 0,
+    viewport_row: u32 = 0,
+    col: u32 = 0,
+    row: u32 = 0,
+    width: u32 = 0,
+    grid_cols: u32 = 0,
+    grid_rows: u32 = 0,
+    z: i32 = 0,
+};
+
+/// C: GhosttyKittyGraphicsVirtualRunFn
+pub const VirtualRunFn = *const fn (?*anyopaque, *const VirtualRun) callconv(lib.calling_conv) void;
+
+pub fn virtual_runs(
+    terminal_: terminal_c.Terminal,
+    callback_: ?VirtualRunFn,
+    user: ?*anyopaque,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+
+    const wrapper = terminal_ orelse return .invalid_value;
+    const callback = callback_ orelse return .invalid_value;
+    const t = wrapper.terminal;
+    if (t.cols == 0 or t.rows == 0) return .success;
+    const cell_width = t.width_px / t.cols;
+    const cell_height = t.height_px / t.rows;
+    const pages = &t.screens.active.pages;
+    const storage = &t.screens.active.kitty_images;
+    const bottom = pages.getBottomRight(.viewport) orelse return .success;
+
+    var it = kitty_unicode.placementIterator(pages.getTopLeft(.viewport), bottom);
+    while (it.next()) |p| {
+        const image = storage.imageById(p.image_id) orelse continue;
+        if (image.data.isPending()) continue;
+        const target = storage.placeholderTarget(p.image_id, p.placement_id) orelse continue;
+        const grid = p.grid(storage, &image, cell_width, cell_height) catch continue;
+        const vp = pages.pointFromPin(.viewport, p.pin) orelse continue;
+        const run: VirtualRun = .{
+            .image_id = p.image_id,
+            .placement_id = p.placement_id,
+            .viewport_col = vp.viewport.x,
+            .viewport_row = vp.viewport.y,
+            .col = p.col,
+            .row = p.row,
+            .width = p.width,
+            .grid_cols = grid.columns,
+            .grid_rows = grid.rows,
+            .z = target.placement.z,
+        };
+        callback(user, &run);
+    }
 
     return .success;
 }
