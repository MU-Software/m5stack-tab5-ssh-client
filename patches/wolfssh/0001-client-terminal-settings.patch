diff --git a/src/ssh.c b/src/ssh.c
index c009764..230e25d 100644
--- a/src/ssh.c
+++ b/src/ssh.c
@@ -1975,6 +1975,29 @@ int wolfSSH_ChangeTerminalSize(WOLFSSH* ssh, word32 columns, word32 rows,
 }
 
 
+/* Sets what the pty-req sends instead of the local terminal's settings.
+ * modes is an encoded mode list without the TTY_OP_END terminator; NULL
+ * keeps the default modes. The strings and modes must outlive the connect.
+ * returns WS_SUCCESS on success */
+int wolfSSH_SetTerminal(WOLFSSH* ssh, const char* term, word32 columns,
+    word32 rows, word32 widthPixels, word32 heightPixels,
+    const byte* modes, word32 modesSz)
+{
+    if (ssh == NULL || term == NULL ||
+            (modes != NULL && modesSz + 1 > TERMINAL_MODES_MAX_SZ))
+        return WS_BAD_ARGUMENT;
+
+    ssh->termType = term;
+    ssh->termColumns = columns;
+    ssh->termRows = rows;
+    ssh->termWidthPixels = widthPixels;
+    ssh->termHeightPixels = heightPixels;
+    ssh->termModes = modes;
+    ssh->termModesSz = modes != NULL ? modesSz : 0;
+    return WS_SUCCESS;
+}
+
+
 void wolfSSH_SetTerminalResizeCb(WOLFSSH* ssh, WS_CallbackTerminalSize cb)
 {
     ssh->termResizeCb = cb;
