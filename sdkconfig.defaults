# SPDX-License-Identifier: GPL-3.0-or-later
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# 80 MHz flash needs rev >= v0.1
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# At 0x8000 the bootloader is 99% full
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_VFS_MAX_COUNT=16
# CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP is not set
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
# Light sleep leaves every pad as it is: isolated, the C6's SDIO and the modem's UART lines would float
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=n
# wolfSSH uses termios constants even with NO_TERMIOS
CONFIG_VFS_SUPPORT_TERMIOS=y
# The app powers the C6 before esp_hosted starts
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
# Else tcpip writes NVS on every DHCP lease
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=n
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
# A window of 1200-byte segments + 2, as Kconfig advises: with the default 6 lwIP dropped the rest of each burst unacknowledged,
# a 200 ms retransmission timeout each, and SSH uploads ran at 60 KB/s
CONFIG_LWIP_TCP_RECVMBOX_SIZE=30
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
CONFIG_LWIP_PPP_SUPPORT=y
# DNS of the path in use, not of whichever interface got an address last
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_FATFS_LFN_HEAP=y
# Software cannot reach the ROM loader under TinyUSB; a bad OTA image must roll back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2
CONFIG_TINYUSB_CDC_RX_BUFSIZE=4096
CONFIG_TINYUSB_MSC_ENABLED=y
# Log lines carry the time of day once the RTC or SNTP set it
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y

# esp_hosted's SDIO transport buffers in PSRAM (the SDMMC DMA reaches it): Wi-Fi as fast, about 28 KB more internal RAM
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y

# The C6 firmware of tools/c6 talks through it (components/c6/include/c6_protocol.h)
CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA=y

# Network Split (C6_NW_SPLIT_SINCE): the C6 runs DHCP and this chip's Wi-Fi interface takes its address; this chip's ports are
# 49152-61439. Without a DHCP client of its own (wifi.c starts one for an older C6), so a lease never clears lwIP's DNS servers
CONFIG_ESP_HOSTED_HOST_FEAT_NW_SPLIT=y
CONFIG_ESP_HOSTED_HOST_FEAT_NW_SPLIT_NETIF_INTERNAL_STATIC=y

# The C6 runs on through restarts of the P4, which restarts its SDIO counters after card init (components/c6) and resets it
# only when the card does not come up
CONFIG_ESP_HOSTED_HOST_CP_RESET_STRATEGY_ONLY_IF_NECESSARY=y

# The Wi-Fi buffers the C6 initialises with (tools/c6/sdkconfig.defaults): the C6 keeps Wi-Fi up through the P4's boots only
# while the P4 asks for the same
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=20
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_RX_BA_WIN=32
