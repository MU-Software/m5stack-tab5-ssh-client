# SPDX-License-Identifier: GPL-3.0-or-later
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# A minimum chip revision above v0.0 allows 80 MHz flash
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# At the default 0x8000 the second-stage bootloader has ~24 KiB and is already 99% full
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_VFS_MAX_COUNT=16
# CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP is not set
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
# wolfSSH's terminal-mode code uses the termios constants even with NO_TERMIOS
CONFIG_VFS_SUPPORT_TERMIOS=y
# Wi-Fi through the ESP32-C6 over SDIO; the C6 is powered by app code before esp_hosted starts
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
# Otherwise the tcpip task writes NVS on every DHCP lease
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=n
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
# .ssh and .config on the SD card need long file names
CONFIG_FATFS_LFN_HEAP=y
