# wolfSSH is patched in a fresh copy under the build directory: the submodule stays clean, and macOS patch silently
# reverses a patch applied twice.
get_filename_component(TOP ${CMAKE_CURRENT_LIST_DIR}/.. ABSOLUTE)

set(WOLFSSL_DIR ${TOP}/third_party/wolfssl)
file(GLOB WOLFSSL_SOURCES ${WOLFSSL_DIR}/wolfcrypt/src/*.c ${WOLFSSL_DIR}/wolfcrypt/src/port/Espressif/*.c)
list(FILTER WOLFSSL_SOURCES EXCLUDE REGEX "/(misc|evp|evp_pk|asn_orig|asn_tsp)\\.c$")

set(WOLFSSH_DIR ${CMAKE_BINARY_DIR}/wolfssh)
file(GLOB patches ${TOP}/patches/wolfssh/*.patch)
file(SHA256 ${TOP}/third_party/wolfssh/src/internal.c key)
foreach(p IN LISTS patches)
    file(SHA256 ${p} h)
    string(APPEND key ${h})
endforeach()
set(stamp ${WOLFSSH_DIR}.stamp)
set(old "")
if(EXISTS ${stamp})
    file(READ ${stamp} old)
endif()
if(NOT old STREQUAL key)
    file(REMOVE_RECURSE ${WOLFSSH_DIR})
    file(COPY ${TOP}/third_party/wolfssh/ DESTINATION ${WOLFSSH_DIR} PATTERN .git EXCLUDE)
    foreach(p IN LISTS patches)
        execute_process(COMMAND patch -p1 -N -s -i ${p} WORKING_DIRECTORY ${WOLFSSH_DIR} RESULT_VARIABLE r)
        if(r)
            message(FATAL_ERROR "${p} does not apply")
        endif()
    endforeach()
    file(WRITE ${stamp} ${key})
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${patches})
file(GLOB WOLFSSH_SOURCES ${WOLFSSH_DIR}/src/*.c)
list(FILTER WOLFSSH_SOURCES EXCLUDE REGEX "/misc\\.c$")
